// ===================================================== 
// BLE SERVER CALLBACKS 
// ===================================================== 
 
class MyServerCallbacks : public BLEServerCallbacks { 
 
  void onConnect(BLEServer *pServer) { 
 
    bluetoothConnected = true; 
 
    Serial.println(); 
    Serial.println("================================"); 
    Serial.println("BLE CONNECTED"); 
    Serial.println("================================"); 
 
    if (bleCharacteristic != nullptr) { 
      bleCharacteristic->setValue("AIRA-STICK_CONNECTED"); 
    } 
  } 
 
  void onDisconnect(BLEServer *pServer) { 
 
    bluetoothConnected = false; 
 
    Serial.println(); 
    Serial.println("================================"); 
    Serial.println("BLE DISCONNECTED"); 
    Serial.println("================================"); 
 
    delay(100); 
 
    BLEDevice::startAdvertising(); 
 
    Serial.println("BLE ADVERTISING RESTARTED"); 
  } 
}; 
 
// ===================================================== 
// SEND MESSAGE TO APP 
// ===================================================== 
 
void notifyApp(const String &message) { 
 
  if (!bluetoothConnected) { 
    return; 
  } 
 
  if (bleCharacteristic == nullptr) { 
    return; 
  } 
 
  bleCharacteristic->setValue(message.c_str()); 
  bleCharacteristic->notify(); 
 
  Serial.print("BLE NOTIFY -> "); 
  Serial.println(message); 
} 
 
// ===================================================== 
// START DESTINATION 
// ===================================================== 
 
void startDestination(String destination, int audioFile) { 
 
  Serial.println(); 
  Serial.println("================================"); 
  Serial.println("DESTINATION SELECTED"); 
  Serial.print("DESTINATION: "); 
  Serial.println(destination); 
  Serial.println("================================"); 
 
  currentDestination = destination; 
 
  navigationActive = true; 
 
  destinationAnnouncementActive = true; 
  destinationAnnouncementStart = millis(); 
 
  lastNavigationCommand = ""; 
 
  obstacleAlertPlayed = false; 
  pitAlertPlayed = false; 
  waterAlertPlayed = false; 
 
  Serial.print("DESTINATION AUDIO -> "); 
 
  if (audioFile < 10) { 
    Serial.print("000"); 
  } else { 
    Serial.print("00"); 
  } 
 
  Serial.print(audioFile); 
  Serial.println(".mp3"); 
 
  playAudio(audioFile); 
 
  notifyApp( 
    "DESTINATION_SELECTED:" + destination 
  ); 
 
  notifyApp( 
    "DESTINATION_AUDIO_STARTED" 
  ); 
 
  notifyApp( 
    "NAVIGATION_STARTED" 
  ); 
 
  Serial.println("NAVIGATION ACTIVE"); 
  Serial.println("WAITING FOR GPS COMMAND..."); 
} 
 
// ===================================================== 
// HANDLE TURN COMMAND 
// ===================================================== 
 
void handleNavigationCommand( 
  const String &command 
) { 
 
  if (!navigationActive) { 
 
    Serial.println( 
      "NAV COMMAND IGNORED - NAVIGATION INACTIVE" 
    ); 
 
    return; 
  } 
 
  // ----------------------------------------------- 
  // TURN LEFT 
  // ----------------------------------------------- 
 
  if (command == "TURN_LEFT") { 
 
    Serial.println(); 
    Serial.println("********************************"); 
    Serial.println("GPS COMMAND: TURN LEFT"); 
    Serial.println("AUDIO FILE: 0011.mp3"); 
    Serial.println("********************************"); 
 
    if ( 
      lastNavigationCommand == "TURN_LEFT" && 
      millis() - lastNavigationCommandTime < 
      NAV_COMMAND_COOLDOWN 
    ) { 
      Serial.println("Duplicate TURN_LEFT ignored"); 
      return; 
    } 
 
    lastNavigationCommand = "TURN_LEFT"; 
    lastNavigationCommandTime = millis(); 
 
    playAudio(11); 
 
    notifyApp( 
      "VOICE_PLAYED:TURN_LEFT" 
    ); 
 
    Serial.println( 
      "TURN LEFT PLAYED ON STICK" 
    ); 
 
    return; 
  } 
 
  // ----------------------------------------------- 
  // TURN RIGHT 
  // ----------------------------------------------- 
 
  if (command == "TURN_RIGHT") { 
 
    Serial.println(); 
    Serial.println("********************************"); 
    Serial.println("GPS COMMAND: TURN RIGHT"); 
    Serial.println("AUDIO FILE: 0012.mp3"); 
    Serial.println("********************************"); 
 
    if ( 
      lastNavigationCommand == "TURN_RIGHT" && 
      millis() - lastNavigationCommandTime < 
      NAV_COMMAND_COOLDOWN 
    ) { 
      Serial.println("Duplicate TURN_RIGHT ignored"); 
      return; 
    } 
 
    lastNavigationCommand = "TURN_RIGHT"; 
    lastNavigationCommandTime = millis(); 
 
    playAudio(12); 
 
    notifyApp( 
      "VOICE_PLAYED:TURN_RIGHT" 
    ); 
 
    Serial.println( 
      "TURN RIGHT PLAYED ON STICK" 
    ); 
 
    return; 
  } 
 
  // ----------------------------------------------- 
  // STRAIGHT 
  // ----------------------------------------------- 
 
  if (command == "STRAIGHT") { 
 
    Serial.println(); 
    Serial.println("********************************"); 
    Serial.println("GPS COMMAND: STRAIGHT"); 
    Serial.println("AUDIO FILE: 0013.mp3"); 
    Serial.println("********************************"); 
 
    if ( 
      lastNavigationCommand == "STRAIGHT" && 
      millis() - lastNavigationCommandTime < 
      NAV_COMMAND_COOLDOWN 
    ) { 
      Serial.println("Duplicate STRAIGHT ignored"); 
      return; 
    } 
 
    lastNavigationCommand = "STRAIGHT"; 
    lastNavigationCommandTime = millis(); 
 
    playAudio(13); 
 
    notifyApp( 
      "VOICE_PLAYED:STRAIGHT" 
    ); 
 
    Serial.println( 
      "STRAIGHT PLAYED ON STICK" 
    ); 
 
    return; 
  } 
 
  // ----------------------------------------------- 
  // UNKNOWN NAV COMMAND 
  // ----------------------------------------------- 
 
  Serial.print( 
    "UNKNOWN NAVIGATION COMMAND: " 
  ); 
 
  Serial.println(command); 
} 
 
// ===================================================== 
// BLE CHARACTERISTIC CALLBACK 
// ===================================================== 
 
class MyCharacteristicCallbacks 
    : public BLECharacteristicCallbacks { 
 
  void onWrite( 
    BLECharacteristic *pCharacteristic 
  ) { 
 
    // IMPORTANT: 
    // Arduino ESP32 BLE library returns Arduino String. 
    // Do NOT use std::string here. 
 
    String command = 
      pCharacteristic->getValue(); 
 
    command.trim(); 
    command.toUpperCase(); 
 
    if (command.length() == 0) { 
      return; 
    } 
 
    Serial.println(); 
    Serial.println("================================"); 
    Serial.println("BLE COMMAND RECEIVED"); 
    Serial.print("COMMAND: "); 
    Serial.println(command); 
    Serial.println("================================"); 
 
    // ================================================= 
    // PING 
    // ================================================= 
 
    if (command == "PING") { 
 
      Serial.println("PING RECEIVED"); 
 
      pCharacteristic->setValue("PONG"); 
 
      if (bluetoothConnected) { 
        pCharacteristic->notify(); 
      } 
 
      return; 
    } 
 
    // ================================================= 
    // STATUS 
    // ================================================= 
 
    if (command == "STATUS") { 
 
      Serial.println("STATUS REQUEST"); 
 
      if (navigationActive) { 
 
        Serial.print( 
          "CURRENT DESTINATION: " 
        ); 
 
        Serial.println( 
          currentDestination 
        ); 
 
        notifyApp( 
          "NAVIGATION_ACTIVE" 
        ); 
      } 
 
      else { 
 
        notifyApp( 
          "NAVIGATION_IDLE" 
        ); 
      } 
 
      return; 
    } 
 
    // ================================================= 
    // RAILWAY STATION 
    // 0010.mp3 
    // ================================================= 
 
    if (command == "DEST_RAILWAY") { 
 
      startDestination( 
        "RAILWAY STATION", 
        10 
      ); 
 
      return; 
    } 
 
    // ================================================= 
    // COLLEGE 
    // 0016.mp3 
    // ================================================= 
 
    if (command == "DEST_COLLEGE") { 
 
      startDestination( 
        "COLLEGE", 
        16 
      ); 
 
      return; 
    } 
 
    // ================================================= 
    // HOSPITAL 
    // 0017.mp3 
    // ================================================= 
 
    if (command == "DEST_HOSPITAL") { 
 
      startDestination( 
        "HOSPITAL", 
        17 
      ); 
 
      return; 
    } 
 
    // ================================================= 
    // BUS STAND 
    // 0018.mp3 
    // ================================================= 
 
    if (command == "DEST_BUS") { 
 
      startDestination( 
        "BUS STAND", 
        18 
      ); 
 
      return; 
    } 
 
    // ================================================= 
    // LIBRARY 
    // 0019.mp3 
    // ================================================= 
 
    if (command == "DEST_LIBRARY") { 
 
      startDestination( 
        "LIBRARY", 
        19 
      ); 
 
      return; 
    } 
 
    // ================================================= 
    // TURN LEFT / RIGHT / STRAIGHT 
    // ================================================= 
 
    if ( 
      command == "TURN_LEFT" || 
      command == "TURN_RIGHT" || 
      command == "STRAIGHT" 
    ) { 
 
      handleNavigationCommand( 
        command 
      ); 
 
      return; 
    } 
 
    // ================================================= 
    // ARRIVED 
    // 0014.mp3 
    // ================================================= 
 
    if (command == "ARRIVED") { 
 
      Serial.println(); 
      Serial.println("================================"); 
      Serial.println("DESTINATION REACHED"); 
      Serial.println("================================"); 
 
      navigationActive = false; 
      destinationAnnouncementActive = false; 
 
      playAudio(14); 
 
      notifyApp( 
        "DESTINATION_ARRIVED" 
      ); 
 
      currentDestination = ""; 
 
      lastNavigationCommand = ""; 
 
      return; 
    } 
 
    // ================================================= 
    // CANCEL 
    // ================================================= 
 
    if ( 
      command == "NAVIGATION_CANCELLED" 
    ) { 
 
      Serial.println(); 
      Serial.println("================================"); 
      Serial.println("NAVIGATION CANCELLED"); 
      Serial.println("================================"); 
 
      navigationActive = false; 
      destinationAnnouncementActive = false; 
 
      playAudio(20); 
 
      notifyApp( 
        "NAVIGATION_CANCELLED" 
      ); 
 
      currentDestination = ""; 
 
      lastNavigationCommand = ""; 
 
      return; 
    } 
 
    // ================================================= 
    // UNKNOWN 
    // ================================================= 
 
    Serial.print( 
      "UNKNOWN APP COMMAND: " 
    ); 
 
    Serial.println(command); 
  } 
}; 
 
// ===================================================== 
// READ ULTRASONIC 
// ===================================================== 
 
float readDistance( 
  int trigPin, 
  int echoPin 
) { 
 
  digitalWrite( 
    trigPin, 
    LOW 
  ); 
 
  delayMicroseconds(2); 
 
  digitalWrite( 
    trigPin, 
    HIGH 
  ); 
 
  delayMicroseconds(10); 
 
  digitalWrite( 
    trigPin, 
    LOW 
  ); 
 
  long duration = 
    pulseIn( 
      echoPin, 
      HIGH, 
      30000 
    ); 
 
  if (duration == 0) { 
    return -1; 
  } 
 
  float distance = 
    duration * 0.0343 / 2.0; 
 
  return distance; 
} 
 
