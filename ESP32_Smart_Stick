    ); 
 
    notifyApp( 
      "DESTINATION_AUDIO_DONE" 
    ); 
 
    notifyApp( 
      "NAVIGATION_READY" 
    ); 
  } 
} 
 
// ===================================================== 
// UPDATE LEDs 
// ===================================================== 
 
void updateLEDs() { 
 
  bool obstacleDetected = 
    ( 
      frontDistance >= 0 && 
      frontDistance < OBSTACLE_DISTANCE 
    ); 
 
  bool pitDetected = 
    ( 
      pitDistance >= 0 && 
      pitDistance > PIT_DISTANCE 
    ); 
 
  bool waterDetected = 
    ( 
      waterValue == HIGH 
    ); 
 
  if ( 
    obstacleDetected || 
    pitDetected || 
    waterDetected 
  ) { 
 
    digitalWrite( 
      RED_LED, 
      HIGH 
    ); 
 
    digitalWrite( 
      GREEN_LED, 
      LOW 
    ); 
  } 
 
  else { 
 
    digitalWrite( 
      GREEN_LED, 
      HIGH 
    ); 
 
    digitalWrite( 
      RED_LED, 
      LOW 
    ); 
  } 
} 
 
// ===================================================== 
// UPDATE LCD 
// ===================================================== 
 
void updateLCD() { 
 
  if ( 
    millis() - 
    lastLCDUpdate < 
    1000 
  ) { 
    return; 
  } 
 
  lastLCDUpdate = millis(); 
 
  lcd.clear(); 
 
  if (navigationActive) { 
 
    lcd.setCursor(0, 0); 
 
    lcd.print("NAV:"); 
 
    lcd.print( 
      currentDestination.substring( 
        0, 
        12 
      ) 
    ); 
 
    lcd.setCursor(0, 1); 
 
    if (destinationAnnouncementActive) { 
      lcd.print("SELECTED..."); 
    } 
    else { 
      lcd.print("NAVIGATING..."); 
    } 
  } 
 
  else if (!lcdPage) { 
 
    lcd.setCursor(0, 0); 
 
    lcd.print("Front:"); 
 
    if (frontDistance < 0) { 
      lcd.print("---"); 
    } 
    else { 
      lcd.print( 
        frontDistance, 
        0 
      ); 
 
      lcd.print("cm"); 
    } 
 
    lcd.setCursor(0, 1); 
 
    lcd.print("Pit:"); 
 
    if (pitDistance < 0) { 
      lcd.print("---"); 
    } 
    else { 
      lcd.print( 
        pitDistance, 
        0 
      ); 
 
      lcd.print("cm"); 
    } 
  } 
 
  else { 
 
    lcd.setCursor(0, 0); 
 
    if (waterValue == HIGH) { 
      lcd.print("WATER DETECTED"); 
    } 
    else { 
      lcd.print("Water: CLEAR"); 
    } 
 
    lcd.setCursor(0, 1); 
 
    if (bluetoothConnected) { 
      lcd.print("BT CONNECTED"); 
    } 
    else { 
      lcd.print("BT WAITING"); 
    } 
  } 
 
  lcdPage = !lcdPage; 
} 
 
// ===================================================== 
// SEND SENSOR DATA 
// ===================================================== 
 
void sendBluetoothData() { 
 
  if (!bluetoothConnected) { 
    return; 
  } 
 
  if ( 
    millis() - 
    lastBluetoothUpdate < 
    1000 
  ) { 
    return; 
  } 
 
  lastBluetoothUpdate = millis(); 
 
  String data = ""; 
 
  data += "FRONT:"; 
 
  if (frontDistance < 0) { 
    data += "NO_ECHO"; 
  } 
  else { 
    data += String( 
      frontDistance, 
      1 
    ); 
 
    data += "cm"; 
  } 
 
  data += ",PIT:"; 
 
  if (pitDistance < 0) { 
    data += "NO_ECHO"; 
  } 
  else { 
    data += String( 
      pitDistance, 
      1 
    ); 
 
    data += "cm"; 
  } 
 
  data += ",WATER:"; 
 
  if (waterValue == HIGH) { 
    data += "DETECTED"; 
  } 
  else { 
    data += "CLEAR"; 
  } 
 
  data += ",NAV:"; 
 
  if (navigationActive) { 
    data += "ACTIVE"; 
  } 
  else { 
    data += "IDLE"; 
  } 
 
  Serial.print( 
    "BLE SEND: " 
  ); 
 
  Serial.println(data); 
 
  if (bleCharacteristic != nullptr) { 
 
    bleCharacteristic->setValue( 
      data.c_str() 
    ); 
 
    bleCharacteristic->notify(); 
  } 
} 
 
// ===================================================== 
// SETUP BLUETOOTH 
// ===================================================== 
 
void setupBluetooth() { 
 
  Serial.println(); 
  Serial.println( 
    "INITIALIZING BLE..." 
  ); 
 
  BLEDevice::init( 
    BLE_DEVICE_NAME 
  ); 
 
  bleServer = 
    BLEDevice::createServer(); 
 
  bleServer->setCallbacks( 
    new MyServerCallbacks() 
  ); 
 
  BLEService *service = 
    bleServer->createService( 
      SERVICE_UUID 
    ); 
 
  bleCharacteristic = 
    service->createCharacteristic( 
 
      CHARACTERISTIC_UUID, 
 
      BLECharacteristic::PROPERTY_READ | 
      BLECharacteristic::PROPERTY_WRITE | 
      BLECharacteristic::PROPERTY_WRITE_NR | 
      BLECharacteristic::PROPERTY_NOTIFY 
    ); 
 
  bleCharacteristic->addDescriptor( 
    new BLE2902() 
  ); 
 
  bleCharacteristic->setValue( 
    "AIRA-STICK READY" 
  ); 
 
  bleCharacteristic->setCallbacks( 
    new MyCharacteristicCallbacks() 
  ); 
 
  service->start(); 
 
  BLEAdvertising *advertising = 
    BLEDevice::getAdvertising(); 
 
  advertising->addServiceUUID( 
    SERVICE_UUID 
  ); 
 
  advertising->setScanResponse(true); 
 
  advertising->setMinPreferred(0x06); 
  advertising->setMinPreferred(0x12); 
 
  BLEDevice::startAdvertising(); 
 
  Serial.println(); 
  Serial.println( 
    "================================" 
  ); 
 
  Serial.println( 
    "BLE READY" 
  ); 
 
  Serial.print( 
    "DEVICE: " 
  ); 
 
  Serial.println( 
    BLE_DEVICE_NAME 
  ); 
 
  Serial.print( 
    "SERVICE UUID: " 
  ); 
 
  Serial.println( 
    SERVICE_UUID 
  ); 
 
  Serial.print( 
    "CHARACTERISTIC UUID: " 
  ); 
 
  Serial.println( 
    CHARACTERISTIC_UUID 
  ); 
 
  Serial.println( 
    "WAITING FOR PHONE..." 
  ); 
 
  Serial.println( 
    "================================" 
  ); 
} 
 
// ===================================================== 
// READ SENSORS 
// ===================================================== 
 
void readSensors() { 
 
  // =================================================== 
  // FRONT 
  // =================================================== 
 
  frontDistance = 
    readDistance( 
      FRONT_TRIG, 
      FRONT_ECHO 
    ); 
 
  if (frontDistance < 0) { 
 
    Serial.println( 
      "FRONT: NO ECHO" 
    ); 
 
    obstacleAlertPlayed = false; 
  } 
 
  else { 
 
    Serial.print( 
      "FRONT: " 
    ); 
 
    Serial.print( 
      frontDistance 
    ); 
 
    Serial.println( 
      " cm" 
    ); 
 
    if ( 
      frontDistance < 
      OBSTACLE_DISTANCE 
    ) { 
 
      Serial.println( 
        "!!! OBSTACLE DETECTED !!!" 
      ); 
 
      if ( 
        !obstacleAlertPlayed && 
        !destinationAnnouncementActive 
      ) { 
 
        // 0002.mp3 
        playAudio(2); 
 
        obstacleAlertPlayed = true; 
      } 
    } 
 
    else { 
 
      obstacleAlertPlayed = false; 
    } 
  } 
 
  // =================================================== 
  // PIT 
  // =================================================== 
 
  pitDistance = 
    readDistance( 
      PIT_TRIG, 
      PIT_ECHO 
    ); 
 
  if (pitDistance < 0) { 
 
    Serial.println( 
      "PIT: NO ECHO" 
    ); 
  } 
 
  else { 
 
    Serial.print( 
      "PIT: " 
    ); 
 
    Serial.print( 
      pitDistance 
    ); 
 
    Serial.println( 
      " cm" 
    ); 
 
    if ( 
      pitDistance > 
      PIT_DISTANCE 
    ) { 
 
      Serial.println( 
        "!!! PIT / STEP DETECTED !!!" 
      ); 
 
      if ( 
        !pitAlertPlayed && 
        !destinationAnnouncementActive 
      ) { 
 
        // 0003.mp3 
        playAudio(3); 
 
        pitAlertPlayed = true; 
      } 
    } 
 
    else { 
 
      pitAlertPlayed = false; 
    } 
  } 
 
  // =================================================== 
  // WATER 
  // =================================================== 
 
  waterValue = 
    digitalRead( 
      WATER_PIN 
    ); 
 
  Serial.print( 
    "WATER: " 
  ); 
 
  Serial.println( 
    waterValue 
  ); 
 
  if (waterValue == HIGH) { 
 
    Serial.println( 
      "!!! WATER DETECTED !!!" 
    ); 
 
    if ( 
      !waterAlertPlayed && 
      !destinationAnnouncementActive 
    ) { 
 
      // 0004.mp3 
      playAudio(4); 
 
      waterAlertPlayed = true; 
    } 
  } 
 
  else { 
 
    waterAlertPlayed = false; 
  } 
 
  Serial.println( 
    "------------------------------" 
  ); 
} 
 
