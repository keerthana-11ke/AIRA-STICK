  // =================================================== 
 
  lcd.clear(); 
 
  lcd.setCursor(0, 0); 
 
  lcd.print( 
    "AIRA READY" 
  ); 
 
  lcd.setCursor(0, 1); 
 
  lcd.print( 
    "BT WAITING" 
  ); 
 
  Serial.println(); 
  Serial.println( 
    "SYSTEM READY!" 
  ); 
 
