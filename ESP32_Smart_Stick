  dfSerial.begin( 
    9600, 
    SERIAL_8N1, 
    DF_RX, 
    DF_TX 
  ); 
 
  delay(2000); 
 
  if ( 
    player.begin( 
      dfSerial 
    ) 
  ) { 
 
    dfPlayerReady = true; 
 
    Serial.println( 
      "DFPLAYER CONNECTED!" 
    ); 
 
    player.volume(25); 
 
    delay(1000); 
 
    // 0001.mp3 
    playAudio(1); 
  } 
 
  else { 
 
    dfPlayerReady = false; 
 
    Serial.println( 
      "DFPLAYER NOT CONNECTED!" 
    ); 
  } 
 
  // =================================================== 
  // BLUETOOTH 
  // =================================================== 
 
  setupBluetooth(); 
 
